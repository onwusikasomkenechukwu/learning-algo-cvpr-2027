     return np.row_stack([x1, x1_new]), np.row_stack([x2, x2_new])
 
 
+def h5_flat_items(h5_file):
+    """(name, array) for every dataset, including ones inside groups: the published Aachen files store
+    image names such as 'db/123.jpg' as nested groups, which File.items() does not descend into."""
+    out = []
+    h5_file.visititems(lambda name, obj: out.append((name, np.array(obj))) if isinstance(obj, h5py.Dataset) else None)
+    return out
+
+
 def get_camera_dicts(K_file_path):
     K_file = h5py.File(K_file_path)
 
